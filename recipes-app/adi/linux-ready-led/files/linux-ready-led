###############################################################################
#! /bin/sh
set -e

PIDFILE=/var/run/linux-ready-led.pid

# source function library
. /etc/init.d/functions

export PATH="${PATH:+$PATH:}/usr/sbin:/sbin"

case "$1" in
  start)
        gpioset -t0 -c gpiochip0 74=1
        ;;
  stop)
        gpioset -t0 -c gpiochip0 74=0
        ;;
  *)
        echo "Usage: /etc/init.d/linux-ready-led {start|stop}"
        exit 1
esac
exit 0
