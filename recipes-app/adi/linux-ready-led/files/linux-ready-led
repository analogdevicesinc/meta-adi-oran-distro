###############################################################################
#! /bin/sh
set -e

PIDFILE=/var/run/linux-ready-led.pid

# source function library
. /etc/init.d/functions

export PATH="${PATH:+$PATH:}/usr/sbin:/sbin"

case "$1" in
  start)
        echo 1 > /sys/class/leds/ds1/brightness
        ;;
  stop)
        echo 0 > /sys/class/leds/ds1/brightness
        ;;
  *)
        echo "Usage: /etc/init.d/linux-ready-led {start|stop}"
        exit 1
esac
exit 0
