###############################################################################
#! /bin/sh
set -e

PIDFILE=/var/run/blink-all-leds.pid

# source function library
. /etc/init.d/functions

export PATH="${PATH:+$PATH:}/usr/sbin:/sbin"

case "$1" in
  start)
        echo "Starting Blink LED Service - Nothing to be done"
        ;;
  stop)
        echo -n "Stopping Blink LED Service Service - blink LED"
        /usr/local/bin/blink-all-leds.sh &
        echo "."
        ;;
  *)
        echo "Usage: /etc/init.d/blinks-all-leds {start|stop}"
        exit 1
esac
exit 0
